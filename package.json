{
  "name": "catalogo-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gerar-api": "ng-openapi-gen -c ng-openapi-gen.json",
    "prestart": "npm run gerar-api",
    "start": "ng serve",
    "prebuild": "npm run gerar-api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run gerar-api",
    "test": "ng test",
    "prelint": "npm run gerar-api",
    "lint": "ng lint",
    "openapi:atualizar": "node scripts/atualizar-openapi.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
